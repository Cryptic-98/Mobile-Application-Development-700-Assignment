<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <include layout="@layout/view_brand_header" />

        <TextView
            android:id="@+id/form_heading"
            style="@style/TextAppearance.SmartPantryManager.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/add_ingredient_title" />

        <EditText
            android:id="@+id/ingredient_name_input"
            style="@style/TextAppearance.SmartPantryManager.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/background_input"
            android:hint="@string/ingredient_name"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:minHeight="56dp"
            android:padding="@dimen/space_md" />

        <EditText
            android:id="@+id/quantity_input"
            style="@style/TextAppearance.SmartPantryManager.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/background_input"
            android:hint="@string/quantity"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:minHeight="56dp"
            android:padding="@dimen/space_md" />

        <Spinner
            android:id="@+id/unit_spinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/background_input"
            android:contentDescription="@string/unit"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md" />

        <EditText
            android:id="@+id/expiry_input"
            style="@style/TextAppearance.SmartPantryManager.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/background_input"
            android:clickable="true"
            android:focusable="true"
            android:importantForAutofill="no"
            android:hint="@string/expiry_date"
            android:inputType="date"
            android:minHeight="56dp"
            android:padding="@dimen/space_md" />

        <TextView
            android:id="@+id/form_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textColor="@color/color_error"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_ingredient_button"
            style="@style/Widget.SmartPantryManager.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_ingredient_button"
            style="@style/Widget.SmartPantryManager.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/delete"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_ingredient_button"
            style="@style/Widget.SmartPantryManager.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/cancel" />
    </LinearLayout>
</ScrollView>
