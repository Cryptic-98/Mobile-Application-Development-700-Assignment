<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/brand_header"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@string/brand_logo_description"
        android:scaleType="fitCenter"
        android:src="@drawable/truffle" />

    <TextView
        android:id="@+id/brand_wordmark"
        style="@style/TextAppearance.SmartPantryManager.Brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:text="@string/brand_name" />
</LinearLayout>
