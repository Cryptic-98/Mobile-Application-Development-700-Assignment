<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:contentDescription="@string/brand_logo_description"
            android:scaleType="fitCenter"
            android:src="@drawable/truffle" />

        <TextView
            style="@style/TextAppearance.SmartPantryManager.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:text="@string/onboarding_title" />

        <TextView
            style="@style/TextAppearance.SmartPantryManager.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/onboarding_intro" />

        <TextView
            style="@style/TextAppearance.SmartPantryManager.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/appearance" />

        <RadioGroup
            android:id="@+id/onboarding_theme_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <RadioButton
                android:id="@+id/onboarding_light_theme"
                style="@style/TextAppearance.SmartPantryManager.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/light_theme" />

            <RadioButton
                android:id="@+id/onboarding_dark_theme"
                style="@style/TextAppearance.SmartPantryManager.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/dark_theme" />

            <RadioButton
                android:id="@+id/onboarding_system_theme"
                style="@style/TextAppearance.SmartPantryManager.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/system_theme" />
        </RadioGroup>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</ScrollView>
