<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recipe_item_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_md"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="1dp"
    app:strokeColor="@color/color_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/recipe_item_image"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:contentDescription="@string/recipe_detail"
            android:scaleType="centerCrop"
            android:src="@drawable/recipe_placeholder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/recipe_item_allergy_warning"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/allergy_warning_description"
                    android:src="@drawable/mark"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/recipe_item_diet_warning"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/space_xs"
                    android:contentDescription="@string/diet_warning_description"
                    android:src="@drawable/crisis"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/recipe_item_name"
                    style="@style/TextAppearance.SmartPantryManager.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/recipe_item_metadata"
                style="@style/TextAppearance.SmartPantryManager.Supporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />

            <TextView
                android:id="@+id/recipe_item_match_status"
                style="@style/TextAppearance.SmartPantryManager.Supporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />

            <TextView
                android:id="@+id/recipe_item_description"
                style="@style/TextAppearance.SmartPantryManager.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:maxLines="3" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
