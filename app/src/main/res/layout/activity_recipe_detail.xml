<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <include layout="@layout/view_brand_header" />

        <ImageView
            android:id="@+id/recipe_detail_image"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="@dimen/space_md"
            android:contentDescription="@string/recipe_detail"
            android:scaleType="centerCrop"
            android:src="@drawable/recipe_placeholder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/recipe_detail_allergy_warning"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/allergy_warning_description"
                android:src="@drawable/mark"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/recipe_detail_diet_warning"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="@dimen/space_xs"
                android:contentDescription="@string/diet_warning_description"
                android:src="@drawable/crisis"
                android:visibility="gone" />

            <TextView
                android:id="@+id/recipe_detail_name"
                style="@style/TextAppearance.SmartPantryManager.Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/recipe_detail_metadata"
            style="@style/TextAppearance.SmartPantryManager.Supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" />

        <TextView
            android:id="@+id/recipe_detail_status"
            style="@style/TextAppearance.SmartPantryManager.Supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone" />

        <TextView
            android:id="@+id/recipe_detail_description"
            style="@style/TextAppearance.SmartPantryManager.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" />

        <TextView
            android:id="@+id/recipe_detail_availability"
            style="@style/TextAppearance.SmartPantryManager.Supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" />

        <TextView
            style="@style/TextAppearance.SmartPantryManager.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/ingredients" />

        <LinearLayout
            android:id="@+id/recipe_ingredients_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:padding="@dimen/space_md" />

        <TextView
            style="@style/TextAppearance.SmartPantryManager.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/preparation" />

        <TextView
            android:id="@+id/recipe_steps_text"
            style="@style/TextAppearance.SmartPantryManager.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/background_card"
            android:lineSpacingExtra="6dp"
            android:padding="@dimen/space_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recipe_detail_back_button"
            style="@style/Widget.SmartPantryManager.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/cancel" />
    </LinearLayout>
</ScrollView>
